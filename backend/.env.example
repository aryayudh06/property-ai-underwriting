# Salin file ini menjadi ".env" lalu sesuaikan bila perlu.

# Lokasi database SQLite
DATABASE_URL=sqlite:///./storage/underwriting.db

# Direktori penyimpanan file upload lokal
STORAGE_DIR=./storage/uploads

# Batas ukuran upload dalam bytes (default 25MB)
MAX_UPLOAD_SIZE=26214400

# Path binary tesseract jika tidak ada di PATH sistem, contoh Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Ambang batas karakter untuk menentukan perlu OCR atau tidak
MIN_TEXT_LENGTH_THRESHOLD=20

# Alamat LLM Extraction Service (service terpisah - lihat folder llm-service/)
LLM_SERVICE_URL=http://localhost:8001
LLM_SERVICE_TIMEOUT=200

# Direktori frontend statis yang akan di-serve oleh FastAPI
FRONTEND_DIR=../frontend

# CORS origins, pisahkan dengan koma jika lebih dari satu
CORS_ORIGINS=*
