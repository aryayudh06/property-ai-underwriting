# Salin file ini menjadi ".env" di folder llm-service/ lalu sesuaikan bila perlu.

# Provider LLM yang dipakai saat LLM_MODE=auto: "gemini" (default, cloud)
# atau "ollama" (LLM lokal - dipertahankan sebagai blueprint, lihat bagian
# OLLAMA_* di bawah). Ganti ke "ollama" untuk kembali 100% ke setup lama.
LLM_PROVIDER=gemini

# --- Gemini API (provider default) ---
# API key Gemini - buat di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai. Cek model & alias terbaru di
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Timeout request ke Gemini API dalam detik
GEMINI_TIMEOUT=120

# --- Ollama (blueprint LLM lokal - opsional, tidak dipakai jika LLM_PROVIDER=gemini) ---
# Alamat server Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Model Ollama yang digunakan - pastikan sudah di-pull terlebih dahulu:
#   ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# Timeout request ke Ollama dalam detik (model besar / CPU-only bisa lambat)
OLLAMA_TIMEOUT=180

# Mode operasi:
#   auto   -> gunakan provider di LLM_PROVIDER jika tersedia/terkonfigurasi,
#             otomatis fallback ke mock jika tidak
#   gemini -> paksa gunakan Gemini (fallback ke mock + warning jika gagal)
#   ollama -> paksa gunakan Ollama (fallback ke mock + warning jika gagal/timeout)
#   mock   -> selalu gunakan mode mock (untuk demo tanpa LLM sama sekali)
LLM_MODE=auto

# Port service ini
PORT=8001

CORS_ORIGINS=*
